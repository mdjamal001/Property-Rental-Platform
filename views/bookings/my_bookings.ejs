<% layout("/layouts/boilerplate.ejs") %>
<div class="row justify-content-center my-4">
  <div class="col-11 col-md-10 col-lg-9">
    <h2 class="font-weight-bold mb-4"><i class="fa-solid fa-receipt me-2 text-danger"></i>Booking Dashboard</h2>

    <!-- Nav Tabs -->
    <ul class="nav nav-tabs mb-4" id="bookingTab" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active font-weight-bold" id="trips-tab" data-bs-toggle="tab" data-bs-target="#trips" type="button" role="tab" aria-controls="trips" aria-selected="true">
          <i class="fa-solid fa-suitcase-rolling me-1"></i> My Trips (<%= myTrips.length %>)
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link font-weight-bold" id="host-tab" data-bs-toggle="tab" data-bs-target="#host" type="button" role="tab" aria-controls="host" aria-selected="false">
          <i class="fa-solid fa-house-user me-1"></i> Host Reservations Received (<%= hostReservations.length %>)
        </button>
      </li>
    </ul>

    <div class="tab-content" id="bookingTabContent">
      <!-- 1. My Trips Tab -->
      <div class="tab-pane fade show active" id="trips" role="tabpanel" aria-labelledby="trips-tab">
        <% if (myTrips.length === 0) { %>
          <div class="text-center py-5 bg-white rounded-4 shadow-sm">
            <i class="fa-solid fa-suitcase-rolling fs-1 text-muted mb-3"></i>
            <h4 class="text-secondary">No trips booked yet!</h4>
            <p class="text-muted">Explore places around the world and reserve your next dream stay.</p>
            <a href="/listings" class="btn btn-danger px-4 rounded-pill mt-2">Explore Properties</a>
          </div>
        <% } else { %>
          <div class="row g-4">
            <% myTrips.forEach(booking => { %>
              <div class="col-12 col-md-6">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative">
                  <div class="row g-0">
                    <div class="col-4 position-relative">
                      <img src="<%= (booking.listing && booking.listing.images && booking.listing.images.length > 0) ? booking.listing.images[0].url : (booking.listing ? booking.listing.image.url : 'https://images.unsplash.com/photo-1571896349842-33c89424de2d?q=80&w=800') %>" class="img-fluid h-100 w-100" style="object-fit: cover;" alt="stay photo">
                    </div>
                    <div class="col-8">
                      <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                          <h6 class="card-title font-weight-bold mb-0 text-truncate" style="max-width: 170px;">
                            <%= booking.listing ? booking.listing.title : 'Deleted Listing' %>
                          </h6>
                          <span class="badge <%= booking.status === 'confirmed' ? 'bg-success' : 'bg-secondary' %>">
                            <%= booking.status.toUpperCase() %>
                          </span>
                        </div>
                        
                        <% if(booking.listing) { %>
                          <p class="text-muted small mb-2"><i class="fa-solid fa-location-dot me-1"></i><%= booking.listing.city %>, <%= booking.listing.country %></p>
                        <% } %>

                        <div class="bg-light p-2 rounded-3 small mb-2">
                          <div class="d-flex justify-content-between">
                            <span class="text-muted">Dates:</span>
                            <strong><%= new Date(booking.checkIn).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %> - <%= new Date(booking.checkOut).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></strong>
                          </div>
                          <div class="d-flex justify-content-between">
                            <span class="text-muted">Total:</span>
                            <strong class="text-danger">&#8377;<%= booking.totalPrice.toLocaleString("en-IN") %></strong>
                          </div>
                        </div>

                        <div class="d-flex gap-2">
                          <a href="/bookings/receipt/<%= booking._id %>" class="btn btn-sm btn-outline-danger w-100">View Receipt</a>
                          <% if(booking.status === 'confirmed') { %>
                            <form action="/bookings/<%= booking._id %>/cancel" method="POST" onsubmit="return confirm('Are you sure you want to cancel this reservation?');" class="w-100">
                              <button class="btn btn-sm btn-outline-secondary w-100">Cancel</button>
                            </form>
                          <% } %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

      <!-- 2. Host Reservations Received Tab -->
      <div class="tab-pane fade" id="host" role="tabpanel" aria-labelledby="host-tab">
        <% if (hostReservations.length === 0) { %>
          <div class="text-center py-5 bg-white rounded-4 shadow-sm">
            <i class="fa-solid fa-house-user fs-1 text-muted mb-3"></i>
            <h4 class="text-secondary">No reservations received yet</h4>
            <p class="text-muted">When guests book your listed properties, their reservation details will appear here.</p>
          </div>
        <% } else { %>
          <div class="table-responsive bg-white rounded-4 shadow-sm p-3">
            <table class="table align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Property</th>
                  <th>Guest</th>
                  <th>Dates</th>
                  <th>Nights</th>
                  <th>Total Payout</th>
                  <th>Status</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% hostReservations.forEach(res => { %>
                  <tr>
                    <td>
                      <strong class="d-block"><%= res.listing ? res.listing.title : 'Deleted Listing' %></strong>
                      <small class="text-muted"><%= res.listing ? res.listing.city : '' %></small>
                    </td>
                    <td>
                      <i class="fa-solid fa-circle-user text-danger me-1"></i>
                      <strong><%= res.guest ? res.guest.username : 'Guest' %></strong>
                    </td>
                    <td class="small">
                      <%= new Date(res.checkIn).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %> - 
                      <%= new Date(res.checkOut).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                    </td>
                    <td><%= res.totalNights %> night(s)</td>
                    <td class="fw-bold text-success">&#8377;<%= res.totalPrice.toLocaleString("en-IN") %></td>
                    <td>
                      <span class="badge <%= res.status === 'confirmed' ? 'bg-success' : 'bg-secondary' %>">
                        <%= res.status.toUpperCase() %>
                      </span>
                    </td>
                    <td>
                      <% if(res.status === 'confirmed') { %>
                        <form action="/bookings/<%= res._id %>/cancel" method="POST" onsubmit="return confirm('Cancel this guest reservation?');">
                          <button class="btn btn-sm btn-outline-danger">Cancel</button>
                        </form>
                      <% } else { %>
                        <span class="text-muted small">&mdash;</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
