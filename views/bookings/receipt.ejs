<% layout("/layouts/boilerplate.ejs") %>
<div class="row justify-content-center my-4">
  <div class="col-11 col-md-8 col-lg-6">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
      <!-- Header Banner -->
      <div class="bg-success text-white p-4 text-center">
        <i class="fa-solid fa-circle-check fs-1 mb-2"></i>
        <h3 class="font-weight-bold mb-1">Reservation Confirmed!</h3>
        <p class="mb-0 text-white-50">Booking Reference: #<%= booking._id.toString().slice(-8).toUpperCase() %></p>
      </div>

      <div class="card-body p-4">
        <!-- Listing info -->
        <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
          <img src="<%= (booking.listing.images && booking.listing.images.length > 0) ? booking.listing.images[0].url : booking.listing.image.url %>" class="rounded-3" style="width: 100px; height: 80px; object-fit: cover;" alt="<%= booking.listing.title %>">
          <div>
            <h5 class="mb-1 font-weight-bold"><%= booking.listing.title %></h5>
            <p class="text-muted mb-0 small"><i class="fa-solid fa-location-dot me-1"></i><%= booking.listing.city %>, <%= booking.listing.country %></p>
            <p class="text-muted mb-0 small">Hosted by <strong><%= booking.listing.owner ? booking.listing.owner.username : 'Host' %></strong></p>
          </div>
        </div>

        <!-- Reservation Details -->
        <h5 class="font-weight-bold mb-3">Reservation Details</h5>
        <div class="row g-3 mb-4">
          <div class="col-6">
            <div class="p-3 bg-light rounded-3">
              <span class="text-muted small d-block">CHECK-IN</span>
              <strong class="text-dark"><%= new Date(booking.checkIn).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %></strong>
            </div>
          </div>
          <div class="col-6">
            <div class="p-3 bg-light rounded-3">
              <span class="text-muted small d-block">CHECK-OUT</span>
              <strong class="text-dark"><%= new Date(booking.checkOut).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %></strong>
            </div>
          </div>
          <div class="col-6">
            <div class="p-3 bg-light rounded-3">
              <span class="text-muted small d-block">DURATION</span>
              <strong class="text-dark"><%= booking.totalNights %> Night(s)</strong>
            </div>
          </div>
          <div class="col-6">
            <div class="p-3 bg-light rounded-3">
              <span class="text-muted small d-block">GUESTS</span>
              <strong class="text-dark"><%= booking.guestsCount || 1 %> Guest(s)</strong>
            </div>
          </div>
        </div>

        <!-- Payment Breakdown -->
        <h5 class="font-weight-bold mb-3">Payment Summary</h5>
        <div class="p-3 bg-light rounded-3 mb-4">
          <div class="d-flex justify-content-between mb-2">
            <span>&#8377;<%= booking.listing.price.toLocaleString("en-IN") %> &times; <%= booking.totalNights %> nights</span>
            <span>&#8377;<%= (booking.listing.price * booking.totalNights).toLocaleString("en-IN") %></span>
          </div>
          <div class="d-flex justify-content-between mb-2 text-muted">
            <span>Service fees & GST (15%)</span>
            <span>&#8377;<%= (booking.totalPrice - (booking.listing.price * booking.totalNights)).toLocaleString("en-IN") %></span>
          </div>
          <hr class="my-2">
          <div class="d-flex justify-content-between font-weight-bold fs-5 text-danger">
            <span>Total Paid</span>
            <span>&#8377;<%= booking.totalPrice.toLocaleString("en-IN") %></span>
          </div>
        </div>

        <div class="d-flex gap-2">
          <a href="/bookings/my-bookings" class="btn btn-outline-danger w-50 py-2 rounded-3"><i class="fa-solid fa-receipt me-1"></i> My Bookings</a>
          <a href="/listings/<%= booking.listing._id %>" class="btn btn-danger w-50 py-2 rounded-3"><i class="fa-solid fa-house me-1"></i> View Property</a>
        </div>
      </div>
    </div>
  </div>
</div>
