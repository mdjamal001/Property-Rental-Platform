      <i class="fa-solid fa-bars"></i>
    </label>
  </div>
  <form action="#">
    <input type="text" placeholder="Location" class="form-control">
    <button class="btn btn-danger text-light" style="border-radius: 40%;"><i
        class="fa-solid fa-magnifying-glass"></i></button>
  </form>

  <div class="overlay"></div>

  <div class="sidebar">
    <div class="title">
      <h4 class="text-danger"><i class="fa-regular fa-compass"></i>&nbsp;WanderNest</h4>
      <div class="closebtn">
        <label for="opcl">
          <i class="fa-solid fa-xmark"></i>
        </label>
      </div>
    </div>
    <div class="sidebar-content">
      <div class="sidebar-content-top">
        <ul>
          <li>
