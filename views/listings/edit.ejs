<% layout("/layouts/boilerplate.ejs") %>
<div class="row justify-content-center my-4">
  <div class="col-md-8 col-lg-7 col-11">
    <div class="card border-0 shadow-sm p-4 rounded-4">
      <h2 class="mb-4 text-primary font-weight-bold"><i class="fa-solid fa-pen-to-square me-2"></i>Edit Listing</h2>
      <form action="/listings/<%= listing._id %>?_method=PATCH" method="post" class="needs-validation" novalidate enctype="multipart/form-data" onsubmit="return confirm('Are you sure you want to update this listing?');">
        
        <!-- Basic Info -->
        <div class="mb-3">
          <label for="title" class="form-label font-weight-bold">Title</label>
          <input type="text" name="title" id="title" class="form-control" value="<%= listing.title %>" required />
          <div class="invalid-feedback">Title is required.</div>
        </div>

        <div class="mb-3">
          <label for="category" class="form-label font-weight-bold">Category</label>
          <select name="category" id="category" class="form-select" required>
            <% 
            const categories = ["Trending", "Farms", "Pools", "Mountains", "Castles", "Lakes", "Views", "Arctic", "Beachfront", "Cities", "Boats", "Skiing", "Towers"];
            categories.forEach(cat => { 
            %>
              <option value="<%= cat %>" <%= listing.category === cat ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          </select>
        </div>

        <div class="mb-3">
          <label for="description" class="form-label font-weight-bold">Description</label>
          <textarea name="description" id="description" class="form-control" rows="3" required><%= listing.description %></textarea>
          <div class="invalid-feedback">Description is required.</div>
        </div>

        <div class="row mb-3">
          <div class="col-md-6">
            <label for="price" class="form-label font-weight-bold">Price per night (&#8377;)</label>
            <input type="number" name="price" id="price" class="form-control" value="<%= listing.price %>" min="1" required />
            <div class="invalid-feedback">Valid price is required.</div>
          </div>
        </div>

        <!-- Occupancy Details -->
        <% let occ = listing.occupancy || { guests: 2, bedrooms: 1, beds: 1, bathrooms: 1 }; %>
        <div class="border rounded-3 p-3 mb-4 bg-light">
          <h6 class="font-weight-bold mb-3"><i class="fa-solid fa-users me-2 text-primary"></i>Occupancy Details</h6>
          <div class="row g-3">
            <div class="col-6 col-sm-3">
              <label for="guests" class="form-label small">Guests</label>
              <input type="number" name="occupancy[guests]" id="guests" class="form-control" value="<%= occ.guests %>" min="1" required />
            </div>
            <div class="col-6 col-sm-3">
              <label for="bedrooms" class="form-label small">Bedrooms</label>
              <input type="number" name="occupancy[bedrooms]" id="bedrooms" class="form-control" value="<%= occ.bedrooms %>" min="0" required />
            </div>
            <div class="col-6 col-sm-3">
              <label for="beds" class="form-label small">Beds</label>
              <input type="number" name="occupancy[beds]" id="beds" class="form-control" value="<%= occ.beds %>" min="0" required />
            </div>
            <div class="col-6 col-sm-3">
              <label for="bathrooms" class="form-label small">Bathrooms</label>
              <input type="number" name="occupancy[bathrooms]" id="bathrooms" class="form-control" value="<%= occ.bathrooms %>" min="0" required />
            </div>
          </div>
        </div>

        <!-- Existing Images Management -->
        <% let imageList = (listing.images && listing.images.length > 0) ? listing.images : [{ url: listing.image.url, filename: 'default' }]; %>
        <div class="mb-4">
          <label class="form-label font-weight-bold mb-2">Existing Photos</label>
          <p class="small text-muted mb-2">Check the box on any photo you wish to delete:</p>
          <div class="row g-2">
            <% imageList.forEach((img, idx) => { %>
              <div class="col-6 col-sm-4 col-md-3">
                <div class="card h-100 border-0 shadow-sm p-1 text-center position-relative">
                  <img src="<%= img.url %>" class="card-img-top rounded" style="height: 90px; object-fit: cover;" alt="listing image">
                  <div class="form-check mt-2 justify-content-center d-flex align-items-center gap-1">
                    <input class="form-check-input" type="checkbox" name="deletedImages" value="<%= img.filename %>" id="del-<%= idx %>">
                    <label class="form-check-label small text-danger" for="del-<%= idx %>">Delete</label>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- Add New Photos (Card-based Appendable & Reorderable) -->
        <div class="mb-4">
          <label class="form-label font-weight-bold">Add Additional Photos</label>
          <input type="file" name="images" id="imagesInput" class="d-none" multiple accept="image/*" />
          
          <div id="imageCardContainer" class="image-upload-wrapper">
            <!-- Big '+' Card ALWAYS first on left -->
            <div id="addImageCard" class="add-image-card" title="Click to add photos">
              <i class="fa-solid fa-plus"></i>
              <span>Add Photos</span>
            </div>
            <!-- Added image cards will append here moving to the right -->
          </div>
          <small class="text-muted d-block mt-2">Click <b>+ Add Photos</b> to append more images. Drag cards to organize display order.</small>
        </div>

        <!-- Location & Map Section -->
        <% 
        let defaultLng = (listing.geometry && listing.geometry.coordinates) ? listing.geometry.coordinates[0] : 73.8567;
        let defaultLat = (listing.geometry && listing.geometry.coordinates) ? listing.geometry.coordinates[1] : 15.2993;
        %>
        <div class="border rounded-3 p-3 mb-4 bg-light">
          <h6 class="font-weight-bold mb-3"><i class="fa-solid fa-map-location-dot me-2 text-primary"></i>Location & Map Pinning</h6>
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label for="city" class="form-label small">City</label>
              <input type="text" name="city" id="cityInput" class="form-control" value="<%= listing.city %>" required />
              <div class="invalid-feedback">City is required.</div>
            </div>
            <div class="col-md-6">
              <label for="country" class="form-label small">Country</label>
              <input type="text" name="country" id="countryInput" class="form-control" value="<%= listing.country %>" required />
              <div class="invalid-feedback">Country is required.</div>
            </div>
          </div>

          <button type="button" id="locateBtn" class="btn btn-outline-primary btn-sm mb-3">
            <i class="fa-solid fa-magnifying-glass-location me-1"></i> Find Location on Map
          </button>

          <p class="small text-muted mb-2">Drag the map marker pin to update precise location:</p>
          <div id="editMap" style="height: 300px; border-radius: 0.75rem;"></div>

          <input type="hidden" name="lat" id="latInput" value="<%= defaultLat %>" />
          <input type="hidden" name="lng" id="lngInput" value="<%= defaultLng %>" />
          <small class="text-muted d-block mt-2">Selected Coordinates: <span id="coordsDisplay" class="fw-bold"><%= defaultLat.toFixed(4) %>, <%= defaultLng.toFixed(4) %></span></small>
        </div>

        <!-- Amenities Selection (Equal Sized Option Cards) -->
        <div class="mb-4">
          <label class="form-label font-weight-bold mb-2">Amenities / Services Included</label>
          <div class="amenities-grid-form">
            <% 
            const amenitiesList = [
              { name: "Wifi", icon: "fa-wifi" },
              { name: "Free Parking", icon: "fa-square-parking" },
              { name: "Pool", icon: "fa-water-ladder" },
              { name: "Air Conditioning", icon: "fa-snowflake" },
              { name: "Kitchen", icon: "fa-kitchen-set" },
              { name: "Dedicated Workspace", icon: "fa-laptop" },
              { name: "Food Included", icon: "fa-utensils" },
              { name: "TV", icon: "fa-tv" },
              { name: "Gym", icon: "fa-dumbbell" },
              { name: "Hot Tub", icon: "fa-hot-tub-person" },
              { name: "Washer", icon: "fa-soap" },
              { name: "BBQ Grill", icon: "fa-fire-burner" }
            ];
            let currentAmenities = listing.amenities || [];
            %>
            <% amenitiesList.forEach(item => { 
                let isChecked = currentAmenities.includes(item.name);
            %>
              <label class="amenity-option-card <%= isChecked ? 'selected' : '' %>" for="amenity-<%= item.name.replace(/\s+/g, '') %>">
                <input class="d-none amenity-checkbox" type="checkbox" name="amenities" value="<%= item.name %>" id="amenity-<%= item.name.replace(/\s+/g, '') %>" <%= isChecked ? 'checked' : '' %>>
                <i class="fa-solid <%= item.icon %>"></i>
                <span><%= item.name %></span>
              </label>
            <% }) %>
          </div>
        </div>

        <div class="d-grid gap-2">
          <button class="btn btn-primary btn-lg rounded-3">Update Listing</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
  // --- 1. Additional Image Upload, Appending, Drag & Drop Reordering ---
  const imagesInput = document.getElementById('imagesInput');
  const addImageCard = document.getElementById('addImageCard');
  const imageContainer = document.getElementById('imageCardContainer');
  let uploadedFiles = [];

  if (addImageCard && imagesInput) {
    addImageCard.addEventListener('click', () => imagesInput.click());

    imagesInput.addEventListener('change', function() {
      const files = Array.from(this.files);
      if (files.length > 0) {
        uploadedFiles.push(...files);
        renderImageCards();
      }
    });
  }

  function syncFileInput() {
    const dt = new DataTransfer();
    uploadedFiles.forEach(file => dt.items.add(file));
    imagesInput.files = dt.files;
  }

  const form = document.querySelector('form');
  if (form) {
    form.addEventListener('submit', function() {
      syncFileInput();
    });
  }

  function renderImageCards() {
    syncFileInput();
    const existingCards = imageContainer.querySelectorAll('.image-card-item');
    existingCards.forEach(card => card.remove());

    uploadedFiles.forEach((file, index) => {
      const reader = new FileReader();
      reader.onload = function(e) {
        const card = document.createElement('div');
        card.className = 'image-card-item';
        card.draggable = true;
        card.dataset.index = index;

        card.innerHTML = `
          <img src="${e.target.result}" alt="photo ${index + 1}">
          <span class="badge-order">#${index + 1}</span>
          <button type="button" class="remove-card-btn" title="Remove photo">&times;</button>
        `;

        card.querySelector('.remove-card-btn').addEventListener('click', (evt) => {
          evt.stopPropagation();
          uploadedFiles.splice(index, 1);
          renderImageCards();
        });

        card.addEventListener('dragstart', (evt) => {
          card.classList.add('dragging');
          evt.dataTransfer.setData('text/plain', index);
        });

        card.addEventListener('dragend', () => {
          card.classList.remove('dragging');
        });

        card.addEventListener('dragover', (evt) => {
          evt.preventDefault();
        });

        card.addEventListener('drop', (evt) => {
          evt.preventDefault();
          const fromIndex = parseInt(evt.dataTransfer.getData('text/plain'));
          const toIndex = index;
          if (!isNaN(fromIndex) && fromIndex !== toIndex) {
            const movedItem = uploadedFiles.splice(fromIndex, 1)[0];
            uploadedFiles.splice(toIndex, 0, movedItem);
            renderImageCards();
          }
        });

        imageContainer.appendChild(card);
      };
      reader.readAsDataURL(file);
    });
  }

  // --- 2. Amenities Option Cards Selection Toggle ---
  const amenityCards = document.querySelectorAll('.amenity-option-card');
  amenityCards.forEach(card => {
    const checkbox = card.querySelector('.amenity-checkbox');
    card.addEventListener('click', () => {
      checkbox.checked = !checkbox.checked;
      if (checkbox.checked) {
        card.classList.add('selected');
      } else {
        card.classList.remove('selected');
      }
    });
  });

  // --- 3. Map & Draggable Pin ---
  let defaultLat = <%= defaultLat %>;
  let defaultLng = <%= defaultLng %>;

  const map = L.map('editMap').setView([defaultLat, defaultLng], 13);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; OpenStreetMap'
  }).addTo(map);

  const marker = L.marker([defaultLat, defaultLng], { draggable: true }).addTo(map);

  function updateCoords(lat, lng) {
    document.getElementById('latInput').value = lat.toFixed(6);
    document.getElementById('lngInput').value = lng.toFixed(6);
    document.getElementById('coordsDisplay').textContent = `${lat.toFixed(4)}, ${lng.toFixed(4)}`;
  }

  marker.on('dragend', function(e) {
    const position = marker.getLatLng();
    updateCoords(position.lat, position.lng);
  });

  map.on('click', function(e) {
    marker.setLatLng(e.latlng);
    updateCoords(e.latlng.lat, e.latlng.lng);
  });

  document.getElementById('locateBtn').addEventListener('click', function() {
    const city = document.getElementById('cityInput').value.trim();
    const country = document.getElementById('countryInput').value.trim();
    const query = [city, country].filter(Boolean).join(', ');

    if (!query) {
      alert("Please enter a city or country first!");
      return;
    }

    fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}`)
      .then(res => res.json())
      .then(data => {
        if (data && data.length > 0) {
          const lat = parseFloat(data[0].lat);
          const lng = parseFloat(data[0].lon);
          map.setView([lat, lng], 13);
          marker.setLatLng([lat, lng]);
          updateCoords(lat, lng);
        } else {
          alert("Location not found on map. Try adjusting your city or country name.");
        }
      })
      .catch(err => {
        console.error(err);
        alert("Geocoding failed. Please set marker manually.");
      });
  });
});
</script>
